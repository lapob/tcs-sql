<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TopCash.Server</RootNamespace>
    <AssemblyName>TopCash.Server</AssemblyName>
    <Version>2.9.0</Version>
    <Product>Top Cash Studio Server</Product>
    <Company>Top Cash Service S.r.l.</Company>
    <ApplicationIcon>..\src\topcash.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <DefineConstants>$(DefineConstants);TOPCASH_SERVER</DefineConstants>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same data layer as the Windows app: one source of truth for import rules and validation. -->
    <Compile Include="..\src\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\src\Store.cs" Link="Shared\Store.cs" />
    <Compile Include="..\src\Imports.cs" Link="Shared\Imports.cs" />
    <Compile Include="..\src\Gestionale.cs" Link="Shared\Gestionale.cs" />
    <Compile Include="..\src\Paths.cs" Link="Shared\Paths.cs" />
    <Compile Include="..\src\Magazzino.cs" Link="Shared\Magazzino.cs" />
    <Compile Include="..\src\Rapportino.cs" Link="Shared\Rapportino.cs" />
    <Compile Include="..\src\Contabilita.cs" Link="Shared\Contabilita.cs" />
    <Compile Include="..\src\Email.cs" Link="Shared\Email.cs" />
    <Compile Include="..\src\Dtr.cs" Link="Shared\Dtr.cs" />
    <Compile Include="..\src\ItalRetail.cs" Link="Shared\ItalRetail.cs" />
    <Compile Include="..\src\Rch.cs" Link="Shared\Rch.cs" />
    <Compile Include="..\src\Edits.cs" Link="Shared\Edits.cs" />
    <Compile Include="..\src\Work.cs" Link="Shared\Work.cs" />
    <Compile Include="..\src\Backup.cs" Link="Shared\Backup.cs" />
    <Compile Include="..\src\Novita.cs" Link="Shared\Novita.cs" />
    <Content Include="..\src\ui\**\*" LinkBase="ui" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- 6.2.x is MIT-licensed; 6.5+ moved to AGPL: keep the version pinned -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <!-- PDFsharp 6.2.4 pulls Pkcs 8.0.1 (known CVEs): force the patched release -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
</Project>
