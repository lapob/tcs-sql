<?xml version="1.0" encoding="utf-8"?>
<!-- The office server runs on the private LAN over plain HTTP; HTTPS servers are also supported. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
