<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps every .NET package inside D:\TopCashSQL (instead of C:\Users\...\.nuget). -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".tools\nuget\packages" />
    <add key="http-cache" value=".tools\nuget\http-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
